<Page x:Class="GestionAcademica.Desktop.Views.PeriodosPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:GestionAcademica.Desktop.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:PeriodosViewModel}"
      Title="Períodos" PreviewKeyDown="OnPreviewKeyDown">

  <Grid Margin="{StaticResource GA.Thickness.24}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  ===================== Encabezado =====================  -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Períodos" Style="{StaticResource GA.Text.Title}" />
        <TextBlock Text="Calendario académico y apertura de ventanas de inscripción." Style="{StaticResource GA.Text.Caption}" Margin="{StaticResource GA.Gap.Top4}" />
      </StackPanel>

      <ui:Button Grid.Column="1" Content="Nuevo período" Appearance="Primary" Command="{Binding NuevaCommand}" Height="{StaticResource GA.Size.Control}" VerticalAlignment="Center">
        <ui:Button.Icon>
          <ui:SymbolIcon Symbol="Add24" />
        </ui:Button.Icon>
      </ui:Button>
    </Grid>

    <!--  ===================== Barra de herramientas =====================  -->
    <Border Grid.Row="1" Style="{StaticResource GA.Toolbar}" Margin="{StaticResource GA.Gap.Top20}">
      <WrapPanel>
        <ui:TextBox x:Name="SearchBox" Width="{StaticResource GA.Size.SearchWidth}" Height="{StaticResource GA.Size.Control}" PlaceholderText="Buscar por año o tipo" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource GA.Gap.FilterItem}">
          <ui:TextBox.Icon>
            <ui:SymbolIcon Symbol="Search24" />
          </ui:TextBox.Icon>
        </ui:TextBox>

        <CheckBox Content="Solo activos" IsChecked="{Binding SoloActivos}" VerticalAlignment="Center" Margin="{StaticResource GA.Gap.FilterItem}" />

        <ui:Button Appearance="Secondary" Command="{Binding RefrescarCommand}" ToolTip="Actualizar (F5)" AutomationProperties.Name="Actualizar" Height="{StaticResource GA.Size.Control}" Margin="{StaticResource GA.Gap.FilterItem}">
          <ui:SymbolIcon Symbol="ArrowClockwise24" />
        </ui:Button>
      </WrapPanel>
    </Border>

    <!--  ===================== Errores =====================  -->
    <ui:InfoBar Grid.Row="2" IsOpen="{Binding HasError, Mode=OneWay}" Severity="Error" Title="No se pudo completar la operación" Message="{Binding ErrorMessage}" IsClosable="False" Margin="{StaticResource GA.Gap.Top12}" />

    <!--  ===================== Contenido =====================  -->
    <Grid Grid.Row="3" Margin="{StaticResource GA.Gap.Top12}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource GA.Card}" Padding="0">
        <Grid>
          <ui:DataGrid x:Name="DataGridPeriodos"
                       ItemsSource="{Binding Periodos}"
                       SelectedItem="{Binding SelectedPeriodo}"
                       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                       GridLinesVisibility="Horizontal"
                       HorizontalGridLinesBrush="{DynamicResource GA.Brush.Stroke}"
                       SelectionMode="Single" SelectionUnit="FullRow"
                       RowHeight="{StaticResource GA.Size.Row}"
                       Background="Transparent" BorderThickness="0" EnableRowVirtualization="True">
            <ui:DataGrid.Columns>

              <DataGridTextColumn Header="Año" Binding="{Binding Anio}" Width="80" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTemplateColumn Header="Tipo" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Tipo, Converter={StaticResource GA.EnumTexto}}" Style="{StaticResource GA.Grid.Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat={}{0:dd/MM/yyyy}}" Width="120" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTextColumn Header="Fin" Binding="{Binding FechaFin, StringFormat={}{0:dd/MM/yyyy}}" Width="120" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTemplateColumn Header="Insc. cursada" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource GA.Thickness.8}">
                      <Ellipse Width="{StaticResource GA.Size.Dot}" Height="{StaticResource GA.Size.Dot}" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource GA.Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding InscripcionComisionesAbierta}" Value="False">
                                <Setter Property="Fill" Value="{DynamicResource GA.Brush.Text.Disabled}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Margin="{StaticResource GA.Gap.Left8}" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource GA.Text.Body}">
                            <Setter Property="Text" Value="Abierta" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding InscripcionComisionesAbierta}" Value="False">
                                <Setter Property="Text" Value="Cerrada" />
                                <Setter Property="Foreground" Value="{DynamicResource GA.Brush.Text.Secondary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="Insc. finales" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource GA.Thickness.8}">
                      <Ellipse Width="{StaticResource GA.Size.Dot}" Height="{StaticResource GA.Size.Dot}" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource GA.Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding InscripcionFinalesAbierta}" Value="False">
                                <Setter Property="Fill" Value="{DynamicResource GA.Brush.Text.Disabled}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Margin="{StaticResource GA.Gap.Left8}" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource GA.Text.Body}">
                            <Setter Property="Text" Value="Abierta" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding InscripcionFinalesAbierta}" Value="False">
                                <Setter Property="Text" Value="Cerrada" />
                                <Setter Property="Foreground" Value="{DynamicResource GA.Brush.Text.Secondary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="Estado" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource GA.Thickness.8}">
                      <Ellipse Width="{StaticResource GA.Size.Dot}" Height="{StaticResource GA.Size.Dot}" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource GA.Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Activo}" Value="False">
                                <Setter Property="Fill" Value="{DynamicResource GA.Brush.Text.Disabled}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Margin="{StaticResource GA.Gap.Left8}" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource GA.Text.Body}">
                            <Setter Property="Text" Value="Activo" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Activo}" Value="False">
                                <Setter Property="Text" Value="Inactivo" />
                                <Setter Property="Foreground" Value="{DynamicResource GA.Brush.Text.Secondary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

            </ui:DataGrid.Columns>
          </ui:DataGrid>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding MostrarVacio, Converter={StaticResource GA.BoolToVisibility}}">
            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="{StaticResource GA.Size.ControlLarge}" HorizontalAlignment="Center" Foreground="{DynamicResource GA.Brush.Text.Secondary}" />
            <TextBlock Text="Sin períodos para mostrar" Style="{StaticResource GA.Text.Subtitle}" HorizontalAlignment="Center" Margin="{StaticResource GA.Gap.Top8}" />
            <TextBlock Text="Ajustá la búsqueda o creá un período nuevo." Style="{StaticResource GA.Text.Caption}" HorizontalAlignment="Center" />
          </StackPanel>

          <ui:ProgressRing IsIndeterminate="True" Width="{StaticResource GA.Size.Control}" Height="{StaticResource GA.Size.Control}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource GA.BoolToVisibility}}" />
        </Grid>
      </Border>

      <!--  ===================== Editor lateral =====================  -->
      <Border Grid.Column="1" Style="{StaticResource GA.Card}" Width="{StaticResource GA.Size.EditorWidth}" Margin="{StaticResource GA.Gap.Left16}" Visibility="{Binding IsEditorOpen, Converter={StaticResource GA.BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{Binding Editor.Titulo}" Style="{StaticResource GA.Text.Subtitle}" Margin="{StaticResource GA.Gap.Bottom12}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Editor}" Margin="{StaticResource GA.Gap.Right8}">

              <TextBlock Text="Año" Style="{StaticResource GA.Text.Label}" />
              <ui:NumberBox Value="{Binding Anio, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Minimum="2000" Maximum="2100" MaxDecimalPlaces="0" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Tipo" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" Height="{StaticResource GA.Size.Control}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource GA.EnumTexto}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid Margin="{StaticResource GA.Gap.Field}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Inicio" Style="{StaticResource GA.Text.Label}" />
                  <DatePicker SelectedDate="{Binding FechaInicio, ValidatesOnNotifyDataErrors=True}" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="{StaticResource GA.Gap.Left12}">
                  <TextBlock Text="Fin" Style="{StaticResource GA.Text.Label}" />
                  <DatePicker SelectedDate="{Binding FechaFin, ValidatesOnNotifyDataErrors=True}" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Ventanas de inscripción" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.FieldLarge}" />
              <CheckBox Content="Inscripción a cursadas abierta" IsChecked="{Binding InscripcionComisionesAbierta}" Margin="{StaticResource GA.Thickness.4}" />
              <CheckBox Content="Inscripción a finales abierta" IsChecked="{Binding InscripcionFinalesAbierta}" Margin="{StaticResource GA.Thickness.4}" />

              <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="{StaticResource GA.Gap.Field}" Visibility="{Binding EsAlta, Converter={StaticResource GA.InverseBoolToVisibility}}" />

            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource GA.Gap.Top12}">
            <ui:Button Content="Cancelar" Command="{Binding CancelarEdicionCommand}" Height="{StaticResource GA.Size.Control}" Margin="{StaticResource GA.Gap.Right8}" />
            <ui:Button Content="Guardar" Appearance="Primary" Command="{Binding GuardarCommand}" Height="{StaticResource GA.Size.Control}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!--  ===================== Pie =====================  -->
    <Grid Grid.Row="4" Margin="{StaticResource GA.Gap.Top12}">
      <TextBlock Style="{StaticResource GA.Text.Caption}">
        <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" de " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" períodos" />
      </TextBlock>
      <TextBlock HorizontalAlignment="Right" Style="{StaticResource GA.Text.Caption}" Text="Enter editar · Ctrl+N nuevo · Ctrl+S guardar · F5 actualizar" />
    </Grid>
  </Grid>
</Page>
