<Page x:Class="GestionAcademica.Desktop.Views.PersonasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:GestionAcademica.Desktop.ViewModels"
      xmlns:conv="clr-namespace:GestionAcademica.Desktop.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:PersonasViewModel}"
      Title="Personas"
      PreviewKeyDown="OnPreviewKeyDown">

  <Page.Resources>
    <conv:RolesTextoConverter x:Key="RolesTexto" />
    <conv:SexoTextoConverter x:Key="SexoTexto" />
  </Page.Resources>

  <Grid Margin="{StaticResource GA.Thickness.24}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===================== Encabezado ===================== -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Personas" Style="{StaticResource GA.Text.Title}" />
        <TextBlock Text="Alta, edición y roles del personal y los alumnos."
                   Style="{StaticResource GA.Text.Caption}"
                   Margin="{StaticResource GA.Gap.Top4}" />
      </StackPanel>

      <ui:Button Grid.Column="1"
                 Content="Nueva persona"
                 Appearance="Primary"
                 Command="{Binding NuevaCommand}"
                 Height="{StaticResource GA.Size.Control}"
                 VerticalAlignment="Center">
        <ui:Button.Icon>
          <ui:SymbolIcon Symbol="Add24" />
        </ui:Button.Icon>
      </ui:Button>
    </Grid>

    <!-- ===================== Barra de herramientas ===================== -->
    <Border Grid.Row="1" Style="{StaticResource GA.Toolbar}" Margin="{StaticResource GA.Gap.Top20}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TextBox x:Name="SearchBox"
                    Grid.Column="0"
                    Width="{StaticResource GA.Size.SearchWidth}"
                    Height="{StaticResource GA.Size.Control}"
                    PlaceholderText="Buscar por nombre, apellido o DNI"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
          <ui:TextBox.Icon>
            <ui:SymbolIcon Symbol="Search24" />
          </ui:TextBox.Icon>
        </ui:TextBox>

        <CheckBox Grid.Column="1"
                  Content="Solo activos"
                  IsChecked="{Binding SoloActivos}"
                  VerticalAlignment="Center"
                  Margin="{StaticResource GA.Gap.Left16}" />

        <ui:Button Grid.Column="2"
                   Appearance="Secondary"
                   Command="{Binding RefrescarCommand}"
                   ToolTip="Actualizar (F5)"
                   Height="{StaticResource GA.Size.Control}"
                   Margin="{StaticResource GA.Gap.Left16}">
          <ui:SymbolIcon Symbol="ArrowClockwise24" />
        </ui:Button>
      </Grid>
    </Border>

    <!-- ===================== Errores ===================== -->
    <ui:InfoBar Grid.Row="2"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Severity="Error"
                Title="No se pudo completar la operación"
                Message="{Binding ErrorMessage}"
                IsClosable="False"
                Margin="{StaticResource GA.Gap.Top12}" />

    <!-- ===================== Contenido ===================== -->
    <Grid Grid.Row="3" Margin="{StaticResource GA.Gap.Top12}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource GA.Card}" Padding="0">
        <Grid>
          <ui:DataGrid x:Name="DataGridPersonas"
                       ItemsSource="{Binding Personas}"
                       SelectedItem="{Binding SelectedPersona}"
                       AutoGenerateColumns="False"
                       CanUserAddRows="False"
                       CanUserDeleteRows="False"
                       CanUserReorderColumns="False"
                       IsReadOnly="True"
                       HeadersVisibility="Column"
                       GridLinesVisibility="Horizontal"
                       HorizontalGridLinesBrush="{DynamicResource GA.Brush.Stroke}"
                       SelectionMode="Single"
                       SelectionUnit="FullRow"
                       RowHeight="{StaticResource GA.Size.Row}"
                       Background="Transparent"
                       BorderThickness="0"
                       EnableRowVirtualization="True">
            <ui:DataGrid.Columns>

              <DataGridTextColumn Header="DNI"
                                  Binding="{Binding Dni}"
                                  Width="110"
                                  ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTextColumn Header="Apellido"
                                  Binding="{Binding Apellido}"
                                  Width="*"
                                  ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTextColumn Header="Nombre"
                                  Binding="{Binding Nombre}"
                                  Width="*"
                                  ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTextColumn Header="Email"
                                  Binding="{Binding Email}"
                                  Width="1.4*"
                                  ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTemplateColumn Header="Estado" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource GA.Thickness.8}">
                      <Ellipse Width="{StaticResource GA.Size.Dot}" Height="{StaticResource GA.Size.Dot}" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource GA.Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Activo}" Value="False">
                                <Setter Property="Fill" Value="{DynamicResource GA.Brush.Text.Disabled}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Margin="{StaticResource GA.Gap.Left8}" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource GA.Text.Body}">
                            <Setter Property="Text" Value="Activo" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Activo}" Value="False">
                                <Setter Property="Text" Value="Inactivo" />
                                <Setter Property="Foreground" Value="{DynamicResource GA.Brush.Text.Secondary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="Roles" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource RolesTexto}}"
                               Style="{StaticResource GA.Grid.Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

            </ui:DataGrid.Columns>
          </ui:DataGrid>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding MostrarVacio, Converter={StaticResource GA.BoolToVisibility}}">
            <ui:SymbolIcon Symbol="People24"
                           FontSize="{StaticResource GA.Size.ControlLarge}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource GA.Brush.Text.Secondary}" />
            <TextBlock Text="Sin personas para mostrar"
                       Style="{StaticResource GA.Text.Subtitle}"
                       HorizontalAlignment="Center"
                       Margin="{StaticResource GA.Gap.Top8}" />
            <TextBlock Text="Ajustá la búsqueda o creá una persona nueva."
                       Style="{StaticResource GA.Text.Caption}"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <ui:ProgressRing IsIndeterminate="True"
                           Width="{StaticResource GA.Size.Control}"
                           Height="{StaticResource GA.Size.Control}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource GA.BoolToVisibility}}" />
        </Grid>
      </Border>

      <!-- ===================== Editor lateral ===================== -->
      <Border Grid.Column="1"
              Style="{StaticResource GA.Card}"
              Width="{StaticResource GA.Size.EditorWidth}"
              Margin="{StaticResource GA.Gap.Left16}"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource GA.BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="{Binding Editor.Titulo}"
                     Style="{StaticResource GA.Text.Subtitle}"
                     Margin="{StaticResource GA.Gap.Bottom12}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Editor}" Margin="{StaticResource GA.Gap.Right8}">

              <TextBlock Text="Nombre" Style="{StaticResource GA.Text.Label}" />
              <ui:TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          Height="{StaticResource GA.Size.Control}"
                          Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Apellido" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          Height="{StaticResource GA.Size.Control}"
                          Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="DNI" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          Height="{StaticResource GA.Size.Control}"
                          Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <Grid Margin="{StaticResource GA.Gap.Field}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Sexo" Style="{StaticResource GA.Text.Label}" />
                  <ComboBox ItemsSource="{Binding Sexos}"
                            SelectedItem="{Binding Sexo, ValidatesOnNotifyDataErrors=True}"
                            Height="{StaticResource GA.Size.Control}"
                            Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource SexoTexto}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="{StaticResource GA.Gap.Left12}">
                  <TextBlock Text="Nacimiento" Style="{StaticResource GA.Text.Label}" />
                  <DatePicker SelectedDate="{Binding FechaNacimiento, ValidatesOnNotifyDataErrors=True}"
                              Height="{StaticResource GA.Size.Control}"
                              Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Email" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          Height="{StaticResource GA.Size.Control}"
                          Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Usuario" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          Height="{StaticResource GA.Size.Control}"
                          Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <StackPanel Visibility="{Binding EsAlta, Converter={StaticResource GA.BoolToVisibility}}">
                <TextBlock Text="Contraseña inicial" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
                <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                Height="{StaticResource GA.Size.Control}"
                                Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />
                <TextBlock Text="Mínimo 8 caracteres."
                           Style="{StaticResource GA.Text.Caption}"
                           Margin="{StaticResource GA.Gap.Top4}" />
              </StackPanel>

              <TextBlock Text="Teléfono" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          Height="{StaticResource GA.Size.Control}"
                          Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Domicilio" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Domicilio, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                          Height="{StaticResource GA.Size.Control}"
                          Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Roles" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.FieldLarge}" />
              <ItemsControl ItemsSource="{Binding Roles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Nombre}"
                              IsChecked="{Binding Seleccionado}"
                              Margin="{StaticResource GA.Thickness.4}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="{StaticResource GA.Gap.Top12}">
            <ui:Button Content="Cancelar"
                       Command="{Binding CancelarEdicionCommand}"
                       Height="{StaticResource GA.Size.Control}"
                       Margin="{StaticResource GA.Gap.Right8}" />
            <ui:Button Content="Guardar"
                       Appearance="Primary"
                       Command="{Binding GuardarCommand}"
                       Height="{StaticResource GA.Size.Control}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== Pie ===================== -->
    <Grid Grid.Row="4" Margin="{StaticResource GA.Gap.Top12}">
      <TextBlock Style="{StaticResource GA.Text.Caption}">
        <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" de " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" personas" />
      </TextBlock>
      <TextBlock HorizontalAlignment="Right"
                 Style="{StaticResource GA.Text.Caption}"
                 Text="Enter editar · Ctrl+N nueva · Ctrl+S guardar · F5 actualizar" />
    </Grid>
  </Grid>
</Page>
