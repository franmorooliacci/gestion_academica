<ui:FluentWindow x:Class="GestionAcademica.Desktop.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:GestionAcademica.Desktop.Views"
                 Title="Gestión Académica"
                 Width="1280"
                 Height="800"
                 MinWidth="1024"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Gestión Académica" ShowMaximize="True" ShowMinimize="True">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="Building24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:InfoBar Grid.Row="1"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Severity="Error"
                Title="No se pudo cargar el contexto de sesión"
                Message="{Binding ErrorMessage}"
                IsClosable="False"
                Margin="{StaticResource GA.Thickness.12}" />

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="2"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True"
                       OpenPaneLength="{StaticResource GA.Size.SidebarWidth}">

      <ui:NavigationView.MenuItems>

        <ui:NavigationViewItem Content="Personas" TargetPageType="{x:Type views:PersonasPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="People24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItemHeader Text="Operación" />

        <ui:NavigationViewItem Content="Carreras" TargetPageType="{x:Type views:CarrerasPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Book24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Materias" TargetPageType="{x:Type views:MateriasPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="BookOpen24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Períodos" TargetPageType="{x:Type views:PeriodosPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="CalendarLtr24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Comisiones" TargetPageType="{x:Type views:ComisionesPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Grid24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Asignaciones docentes" TargetPageType="{x:Type views:AsignacionesDocentesPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Person24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Exámenes" TargetPageType="{x:Type views:ExamenesPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Document24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItemHeader Text="Consulta" />

        <ui:NavigationViewItem Content="Inscripciones" TargetPageType="{x:Type views:InscripcionesPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Clipboard24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="Actas" TargetPageType="{x:Type views:ActasPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DocumentBulletList24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

      </ui:NavigationView.MenuItems>
    </ui:NavigationView>

    <Border Grid.Row="3"
            BorderBrush="{DynamicResource GA.Brush.Stroke}"
            BorderThickness="0,1,0,0"
            Padding="{StaticResource GA.Gap.StatusBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding SessionText}"
                   Style="{StaticResource GA.Text.Caption}"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <ui:ProgressRing IsIndeterminate="True"
                           Width="{StaticResource GA.Size.Progress}"
                           Height="{StaticResource GA.Size.Progress}"
                           Margin="{StaticResource GA.Gap.Right8}"
                           Visibility="{Binding IsBusy, Converter={StaticResource GA.BoolToVisibility}}" />
          <TextBlock Text="Carrera activa"
                     Style="{StaticResource GA.Text.Caption}"
                     VerticalAlignment="Center"
                     Margin="{StaticResource GA.Gap.Right8}" />
          <ComboBox Width="{StaticResource GA.Size.FilterWidth}"
                    Height="{StaticResource GA.Size.Control}"
                    ItemsSource="{Binding Carreras}"
                    SelectedItem="{Binding CarreraSeleccionada}"
                    DisplayMemberPath="Texto"
                    AutomationProperties.Name="Carrera activa" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Style="{StaticResource GA.Text.Caption}"
                   Text="Escritorio · rol administrativo" />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
