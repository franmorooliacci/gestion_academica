<Page x:Class="GestionAcademica.Desktop.Views.MateriasPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:GestionAcademica.Desktop.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:MateriasViewModel}"
      Title="Materias" PreviewKeyDown="OnPreviewKeyDown">

  <Grid Margin="{StaticResource GA.Thickness.24}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  ===================== Encabezado =====================  -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Materias" Style="{StaticResource GA.Text.Title}" />
        <TextBlock Text="Plan de estudios por carrera y correlatividades entre materias." Style="{StaticResource GA.Text.Caption}" Margin="{StaticResource GA.Gap.Top4}" />
      </StackPanel>

      <ui:Button Grid.Column="1" Content="Nueva materia" Appearance="Primary" Command="{Binding NuevaCommand}" Height="{StaticResource GA.Size.Control}" VerticalAlignment="Center">
        <ui:Button.Icon>
          <ui:SymbolIcon Symbol="Add24" />
        </ui:Button.Icon>
      </ui:Button>
    </Grid>

    <!--  ===================== Barra de herramientas =====================  -->
    <Border Grid.Row="1" Style="{StaticResource GA.Toolbar}" Margin="{StaticResource GA.Gap.Top20}">
      <WrapPanel>
        <ui:TextBox x:Name="SearchBox" Width="{StaticResource GA.Size.SearchWidth}" Height="{StaticResource GA.Size.Control}" PlaceholderText="Buscar por código o nombre" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource GA.Gap.FilterItem}">
          <ui:TextBox.Icon>
            <ui:SymbolIcon Symbol="Search24" />
          </ui:TextBox.Icon>
        </ui:TextBox>

        <ComboBox Width="{StaticResource GA.Size.FilterWidth}" Height="{StaticResource GA.Size.Control}" ItemsSource="{Binding CarrerasFiltro}" SelectedItem="{Binding CarreraFiltro}" DisplayMemberPath="Texto" Margin="{StaticResource GA.Gap.FilterItem}" />

        <CheckBox Content="Solo activas" IsChecked="{Binding SoloActivas}" VerticalAlignment="Center" Margin="{StaticResource GA.Gap.FilterItem}" />

        <ui:Button Appearance="Secondary" Command="{Binding RefrescarCommand}" ToolTip="Actualizar (F5)" AutomationProperties.Name="Actualizar" Height="{StaticResource GA.Size.Control}" Margin="{StaticResource GA.Gap.FilterItem}">
          <ui:SymbolIcon Symbol="ArrowClockwise24" />
        </ui:Button>
      </WrapPanel>
    </Border>

    <!--  ===================== Errores =====================  -->
    <ui:InfoBar Grid.Row="2" IsOpen="{Binding HasError, Mode=OneWay}" Severity="Error" Title="No se pudo completar la operación" Message="{Binding ErrorMessage}" IsClosable="False" Margin="{StaticResource GA.Gap.Top12}" />

    <!--  ===================== Contenido =====================  -->
    <Grid Grid.Row="3" Margin="{StaticResource GA.Gap.Top12}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource GA.Card}" Padding="0">
        <Grid>
          <ui:DataGrid x:Name="DataGridMaterias"
                       ItemsSource="{Binding Materias}"
                       SelectedItem="{Binding SelectedMateria}"
                       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                       GridLinesVisibility="Horizontal"
                       HorizontalGridLinesBrush="{DynamicResource GA.Brush.Stroke}"
                       SelectionMode="Single" SelectionUnit="FullRow"
                       RowHeight="{StaticResource GA.Size.Row}"
                       Background="Transparent" BorderThickness="0" EnableRowVirtualization="True">
            <ui:DataGrid.Columns>

              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTextColumn Header="Carrera" Binding="{Binding CarreraNombre}" Width="1.3*" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTextColumn Header="Año" Binding="{Binding AnioEnCarrera}" Width="70" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTemplateColumn Header="Régimen" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding RegimenCursada, Converter={StaticResource GA.EnumTexto}}" Style="{StaticResource GA.Grid.Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="Carga horaria" Binding="{Binding CargaHorariaTotal, StringFormat={}{0} h}" Width="120" ElementStyle="{StaticResource GA.Grid.Text}" />

              <DataGridTemplateColumn Header="Estado" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource GA.Thickness.8}">
                      <Ellipse Width="{StaticResource GA.Size.Dot}" Height="{StaticResource GA.Size.Dot}" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource GA.Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Activa}" Value="False">
                                <Setter Property="Fill" Value="{DynamicResource GA.Brush.Text.Disabled}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Margin="{StaticResource GA.Gap.Left8}" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource GA.Text.Body}">
                            <Setter Property="Text" Value="Activa" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Activa}" Value="False">
                                <Setter Property="Text" Value="Inactiva" />
                                <Setter Property="Foreground" Value="{DynamicResource GA.Brush.Text.Secondary}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

            </ui:DataGrid.Columns>
          </ui:DataGrid>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding MostrarVacio, Converter={StaticResource GA.BoolToVisibility}}">
            <ui:SymbolIcon Symbol="BookOpen24" FontSize="{StaticResource GA.Size.ControlLarge}" HorizontalAlignment="Center" Foreground="{DynamicResource GA.Brush.Text.Secondary}" />
            <TextBlock Text="Sin materias para mostrar" Style="{StaticResource GA.Text.Subtitle}" HorizontalAlignment="Center" Margin="{StaticResource GA.Gap.Top8}" />
            <TextBlock Text="Ajustá los filtros o creá una materia nueva." Style="{StaticResource GA.Text.Caption}" HorizontalAlignment="Center" />
          </StackPanel>

          <ui:ProgressRing IsIndeterminate="True" Width="{StaticResource GA.Size.Control}" Height="{StaticResource GA.Size.Control}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource GA.BoolToVisibility}}" />
        </Grid>
      </Border>

      <!--  ===================== Editor lateral =====================  -->
      <Border Grid.Column="1" Style="{StaticResource GA.Card}" Width="{StaticResource GA.Size.EditorWidth}" Margin="{StaticResource GA.Gap.Left16}" Visibility="{Binding IsEditorOpen, Converter={StaticResource GA.BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{Binding Editor.Titulo}" Style="{StaticResource GA.Text.Subtitle}" Margin="{StaticResource GA.Gap.Bottom12}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Editor}" Margin="{StaticResource GA.Gap.Right8}">

              <TextBlock Text="Carrera" Style="{StaticResource GA.Text.Label}" />
              <ComboBox ItemsSource="{Binding Carreras}" SelectedItem="{Binding CarreraSeleccionada, ValidatesOnNotifyDataErrors=True}" DisplayMemberPath="Texto" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Código" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Nombre" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Año en la carrera" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:NumberBox Value="{Binding AnioEnCarrera, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Minimum="1" Maximum="20" MaxDecimalPlaces="0" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <TextBlock Text="Régimen" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ComboBox ItemsSource="{Binding Regimenes}" SelectedItem="{Binding RegimenCursada}" Height="{StaticResource GA.Size.Control}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource GA.EnumTexto}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="Carga horaria total (h)" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
              <ui:NumberBox Value="{Binding CargaHorariaTotal, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Minimum="1" Maximum="5000" MaxDecimalPlaces="0" Height="{StaticResource GA.Size.Control}" Validation.ErrorTemplate="{StaticResource GA.Validation.ErrorTemplate}" />

              <CheckBox Content="Activa" IsChecked="{Binding Activa}" Margin="{StaticResource GA.Gap.Field}" Visibility="{Binding EsAlta, Converter={StaticResource GA.InverseBoolToVisibility}}" />

              <!--  ===================== Correlatividades =====================  -->
              <StackPanel Visibility="{Binding EsAlta, Converter={StaticResource GA.InverseBoolToVisibility}}" Margin="{StaticResource GA.Gap.FieldLarge}">
                <TextBlock Text="Correlatividades" Style="{StaticResource GA.Text.Label}" />

                <ItemsControl ItemsSource="{Binding Correlatividades}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource GA.Card}" Padding="{StaticResource GA.Thickness.8}" Margin="{StaticResource GA.Gap.Bottom8}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding MateriaRequisitoNombre}" Style="{StaticResource GA.Text.Body}" />
                            <TextBlock Text="{Binding TipoRequisito, Converter={StaticResource GA.EnumTexto}}" Style="{StaticResource GA.Text.Caption}" />
                          </StackPanel>

                          <ui:Button Grid.Column="1" Appearance="Secondary" ToolTip="Quitar correlatividad" AutomationProperties.Name="Quitar correlatividad" Height="{StaticResource GA.Size.Control}" Command="{Binding DataContext.QuitarCorrelatividadCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Delete24" />
                          </ui:Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Sin correlatividades cargadas." Style="{StaticResource GA.Text.Caption}" Visibility="{Binding TieneCorrelatividades, Converter={StaticResource GA.InverseBoolToVisibility}}" />

                <TextBlock Text="Materia requisito" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
                <ComboBox ItemsSource="{Binding Requisitos}" SelectedItem="{Binding RequisitoSeleccionado}" DisplayMemberPath="Texto" Height="{StaticResource GA.Size.Control}" />

                <TextBlock Text="Tipo de requisito" Style="{StaticResource GA.Text.Label}" Margin="{StaticResource GA.Gap.Field}" />
                <ComboBox ItemsSource="{Binding TiposRequisito}" SelectedItem="{Binding TipoRequisito}" Height="{StaticResource GA.Size.Control}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource GA.EnumTexto}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <ui:Button Content="Agregar correlatividad" Appearance="Secondary" Height="{StaticResource GA.Size.Control}" HorizontalAlignment="Right" Margin="{StaticResource GA.Gap.Top8}" Command="{Binding DataContext.AgregarCorrelatividadCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource GA.Gap.Top12}">
            <ui:Button Content="Cancelar" Command="{Binding CancelarEdicionCommand}" Height="{StaticResource GA.Size.Control}" Margin="{StaticResource GA.Gap.Right8}" />
            <ui:Button Content="Guardar" Appearance="Primary" Command="{Binding GuardarCommand}" Height="{StaticResource GA.Size.Control}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!--  ===================== Pie =====================  -->
    <Grid Grid.Row="4" Margin="{StaticResource GA.Gap.Top12}">
      <TextBlock Style="{StaticResource GA.Text.Caption}">
        <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" de " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" materias" />
      </TextBlock>
      <TextBlock HorizontalAlignment="Right" Style="{StaticResource GA.Text.Caption}" Text="Enter editar · Ctrl+N nueva · Ctrl+S guardar · F5 actualizar" />
    </Grid>
  </Grid>
</Page>
