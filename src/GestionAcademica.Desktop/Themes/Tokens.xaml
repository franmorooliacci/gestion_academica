<!--
  Tokens de diseño — fuente única de verdad visual del escritorio.
  Regla: ninguna vista puede declarar colores, tamaños de fuente, márgenes ni radios literales.
  Los valores de color del tema claro viven acá; Tokens.Dark.xaml redefine SOLO los colores.
  Escala Fluent 2 (Windows 11).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ===================== Color (tema claro) ===================== -->
  <SolidColorBrush x:Key="GA.Brush.Layer" Color="#F3F3F3" />
  <SolidColorBrush x:Key="GA.Brush.LayerAlt" Color="#FFFFFF" />
  <SolidColorBrush x:Key="GA.Brush.LayerAlt2" Color="#FAFAFA" />
  <SolidColorBrush x:Key="GA.Brush.Stroke" Color="#E1E1E1" />
  <SolidColorBrush x:Key="GA.Brush.StrokeStrong" Color="#C7C7C7" />
  <SolidColorBrush x:Key="GA.Brush.Text.Primary" Color="#1A1A1A" />
  <SolidColorBrush x:Key="GA.Brush.Text.Secondary" Color="#5C5C5C" />
  <SolidColorBrush x:Key="GA.Brush.Text.Disabled" Color="#9A9A9A" />
  <SolidColorBrush x:Key="GA.Brush.Accent" Color="#0067C0" />
  <SolidColorBrush x:Key="GA.Brush.AccentSubtle" Color="#E5F1FB" />
  <SolidColorBrush x:Key="GA.Brush.Danger" Color="#C42B1C" />
  <SolidColorBrush x:Key="GA.Brush.Success" Color="#0F7B0F" />
  <SolidColorBrush x:Key="GA.Brush.Warning" Color="#9D5D00" />

  <!-- ===================== Tipografía ===================== -->
  <FontFamily x:Key="GA.Font.Family">Segoe UI Variable Text, Segoe UI</FontFamily>

  <sys:Double x:Key="GA.Font.Size.Caption">12</sys:Double>
  <sys:Double x:Key="GA.Font.Size.Body">14</sys:Double>
  <sys:Double x:Key="GA.Font.Size.Subtitle">20</sys:Double>
  <sys:Double x:Key="GA.Font.Size.Title">28</sys:Double>
  <sys:Double x:Key="GA.Font.Size.TitleLarge">40</sys:Double>

  <sys:Double x:Key="GA.Font.LineHeight.Caption">16</sys:Double>
  <sys:Double x:Key="GA.Font.LineHeight.Body">20</sys:Double>
  <sys:Double x:Key="GA.Font.LineHeight.Subtitle">28</sys:Double>
  <sys:Double x:Key="GA.Font.LineHeight.Title">36</sys:Double>
  <sys:Double x:Key="GA.Font.LineHeight.TitleLarge">52</sys:Double>

  <!-- ===================== Espaciado (grilla de 4 px) ===================== -->
  <sys:Double x:Key="GA.Space.2">2</sys:Double>
  <sys:Double x:Key="GA.Space.4">4</sys:Double>
  <sys:Double x:Key="GA.Space.8">8</sys:Double>
  <sys:Double x:Key="GA.Space.12">12</sys:Double>
  <sys:Double x:Key="GA.Space.16">16</sys:Double>
  <sys:Double x:Key="GA.Space.24">24</sys:Double>
  <sys:Double x:Key="GA.Space.32">32</sys:Double>

  <Thickness x:Key="GA.Thickness.4">4</Thickness>
  <Thickness x:Key="GA.Thickness.8">8</Thickness>
  <Thickness x:Key="GA.Thickness.12">12</Thickness>
  <Thickness x:Key="GA.Thickness.16">16</Thickness>
  <Thickness x:Key="GA.Thickness.24">24</Thickness>

  <!--
    Espaciado direccional (Margin/Padding). `GA.Space.*` son Double y no sirven
    para Margin (es Thickness); `GA.Thickness.*` es uniforme, así que los márgenes
    con lados distintos usan estos tokens. Escala de 4 px.
  -->
  <Thickness x:Key="GA.Gap.Top4">0,4,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Top8">0,8,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Top12">0,12,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Top16">0,16,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Top20">0,20,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Top24">0,24,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Bottom8">0,0,0,8</Thickness>
  <Thickness x:Key="GA.Gap.Bottom12">0,0,0,12</Thickness>
  <Thickness x:Key="GA.Gap.Left8">8,0,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Left12">12,0,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Left16">16,0,0,0</Thickness>
  <Thickness x:Key="GA.Gap.Right8">0,0,8,0</Thickness>
  <Thickness x:Key="GA.Gap.Field">0,12,0,4</Thickness>
  <Thickness x:Key="GA.Gap.FieldLarge">0,16,0,4</Thickness>
  <Thickness x:Key="GA.Gap.FieldXL">0,24,0,4</Thickness>
  <Thickness x:Key="GA.Gap.Page">32,0,32,24</Thickness>
  <Thickness x:Key="GA.Gap.StatusBar">12,8</Thickness>
  <Thickness x:Key="GA.Gap.FilterItem">0,0,8,8</Thickness>

  <!-- ===================== Tamaños ===================== -->
  <sys:Double x:Key="GA.Size.Control">32</sys:Double>
  <sys:Double x:Key="GA.Size.ControlLarge">40</sys:Double>
  <sys:Double x:Key="GA.Size.Row">32</sys:Double>
  <sys:Double x:Key="GA.Size.SidebarWidth">220</sys:Double>
  <sys:Double x:Key="GA.Size.EditorWidth">360</sys:Double>
  <sys:Double x:Key="GA.Size.SearchWidth">320</sys:Double>
  <sys:Double x:Key="GA.Size.FilterWidth">220</sys:Double>
  <sys:Double x:Key="GA.Size.Progress">24</sys:Double>
  <sys:Double x:Key="GA.Size.Dot">8</sys:Double>

  <!-- ===================== Radios ===================== -->
  <CornerRadius x:Key="GA.Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="GA.Radius.Card">8</CornerRadius>

</ResourceDictionary>
