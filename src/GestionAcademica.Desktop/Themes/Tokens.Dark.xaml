<!--
  Overrides del tema oscuro. Debe contener EXACTAMENTE las mismas claves de color que Tokens.xaml.
  Se fusiona después de Tokens.xaml cuando el tema activo es oscuro (ver ThemeService).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="GA.Brush.Layer" Color="#202020" />
  <SolidColorBrush x:Key="GA.Brush.LayerAlt" Color="#272727" />
  <SolidColorBrush x:Key="GA.Brush.LayerAlt2" Color="#2D2D2D" />
  <SolidColorBrush x:Key="GA.Brush.Stroke" Color="#3A3A3A" />
  <SolidColorBrush x:Key="GA.Brush.StrokeStrong" Color="#5A5A5A" />
  <SolidColorBrush x:Key="GA.Brush.Text.Primary" Color="#FFFFFF" />
  <SolidColorBrush x:Key="GA.Brush.Text.Secondary" Color="#C7C7C7" />
  <SolidColorBrush x:Key="GA.Brush.Text.Disabled" Color="#6E6E6E" />
  <SolidColorBrush x:Key="GA.Brush.Accent" Color="#60CDFF" />
  <SolidColorBrush x:Key="GA.Brush.AccentSubtle" Color="#1F3A4D" />
  <SolidColorBrush x:Key="GA.Brush.Danger" Color="#FF99A4" />
  <SolidColorBrush x:Key="GA.Brush.Success" Color="#6CCB5F" />
  <SolidColorBrush x:Key="GA.Brush.Warning" Color="#FCE100" />

</ResourceDictionary>
